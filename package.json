{
  "name": "drizzle-marker",
  "displayName": "Drizzle Marker",
  "description": "Marks the names Drizzle ORM fixes, like pgTable, where and onDelete, so you can tell them apart from your own code.",
  "version": "0.0.1",
  "publisher": "shoshindev",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/shoshindev/drizzle-marker.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "drizzle",
    "drizzle-orm",
    "orm",
    "highlight",
    "highlighter",
    "syntax"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact"
  ],
  "contributes": {
    "commands": [
      {
        "command": "drizzleMarker.toggle",
        "title": "Drizzle Marker: Toggle Marks"
      }
    ],
    "colors": [
      {
        "id": "drizzleMarker.background",
        "description": "Background color of the marks. Keep it translucent so the text stays readable.",
        "defaults": {
          "dark": "#14B8A62E",
          "light": "#14B8A62E",
          "highContrast": "#14B8A642",
          "highContrastLight": "#14B8A62E"
        }
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "check": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/findMarks.test.ts test/markMemory.test.ts test/drizzleFiles.test.ts test/imports.test.ts test/corpus.test.ts test/shapes.test.ts test/contrast.test.ts",
    "shapes": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generateShapes.ts",
    "audit-marks": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/audit.ts",
    "vsix": "vsce package --no-dependencies",
    "vscode:prepublish": "node notices.mjs && node esbuild.mjs --production",
    "contrast": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/contrast.ts"
  },
  "devDependencies": {
    "@sveltejs/acorn-typescript": "1.0.13",
    "@types/node": "24.19.2",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "4.1.0",
    "acorn": "8.19.0",
    "drizzle-arktype": "0.1.3",
    "drizzle-kit": "0.31.11",
    "drizzle-kit-1": "npm:drizzle-kit@1.0.0-rc.5",
    "drizzle-orm": "0.45.4",
    "drizzle-orm-1": "npm:drizzle-orm@1.0.0-rc.5",
    "drizzle-seed": "0.3.1",
    "drizzle-typebox": "0.3.3",
    "drizzle-valibot": "0.4.2",
    "drizzle-zod": "0.8.3",
    "esbuild": "0.28.2",
    "ovsx": "1.3.0",
    "typescript": "7.0.2",
    "typescript-6": "npm:typescript@6.0.3"
  }
}
